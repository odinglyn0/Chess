{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/chess-gantry/move.schema.json",
  "title": "Chess gantry move delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["position", "px", "py", "nx", "ny"],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "position": {
      "description": "Stable id of the piece being moved",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "px": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "py": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "nx": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "ny": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "capture": {
      "description": "Optional explicit captured piece and square; required for en passant",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      }
    }
  }
}
