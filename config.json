
{
  "serial": {
    "port": "/dev/ttyUSB0",
    "baudrate": 115200,
    "fallback_baudrates": [
      115200,
      250000
    ],
    "read_timeout_s": 0.25,
    "write_timeout_s": 2.0,
    "command_timeout_s": 120.0,
    "startup_wait_s": 2.5,
    "verify_marlin": true,
    "handshake_timeout_s": 5.0
  },

  "board": {
    "width": 8,
    "height": 8,
    "square_size_mm": 43.75,
    "origin_x_mm": 21.875,
    "origin_y_mm": 21.875,
    "flip_x": false,
    "flip_y": false,
    "swap_xy": false
  },

  "workspace": {
    "min_x_mm": 0.0,
    "max_x_mm": 350.0,
    "min_y_mm": 0.0,
    "max_y_mm": 350.0
  },

  "motion": {
    "travel_feed_mm_min": 1200.0,
    "drag_feed_mm_min": 600.0,
    "magnet_on_dwell_ms": 300,
    "magnet_off_dwell_ms": 300,
    "park_after_move": false,
    "park_x_mm": null,
    "park_y_mm": null
  },

  "magnet": {
    "on_commands": [
      "M106 S255"
    ],
    "off_commands": [
      "M107"
    ]
  },

  "planner": {
    "kind": "astar",
    "grid_step_mm": 5.0,
    "obstacle_keepout_mm": 12.0,
    "allow_diagonal": true,
    "simplify_path": true,
    "max_expanded_nodes": 100000
  },

  "capture": {
    "enabled": false,
    "slots": []
  },
  
  "safety": {
    "calibrated": true,
    "home_before_execute": false,
    "home_commands": [
      "M107",
      "M82",
      "M302 P1",
      "M92 X80 Y80 E80",
      "M203 X200 Y200 E50",
      "M201 X500 Y500 E300",
      "M205 X5 Y5 E5",
      "G92 X0 Y350 E0",
      "M302 P0",
      "M400"
    ],
    "preflight_commands": [
      "M115"
    ],
    "emergency_stop_command": "M112"
  }
}
