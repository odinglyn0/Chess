# Copy to .env, then run ./scripts/docker_host_setup.sh to fill in the real
# host group IDs and confirm the device nodes exist.

# --- image build -------------------------------------------------------------
FEDORA_VERSION=42
UV_VERSION=
INCLUDE_GPIO=1
# INCLUDE_DEV_TOOLS=1 adds bash, node and npm so the dashboard's "Run all
# tests", "Formatting and policy" and "Complete demo readiness" buttons work.
# It also stops the runner from being distroless. Leave at 0 for deployment.
INCLUDE_DEV_TOOLS=0
CHESS_GANTRY_TAG=0.2.0

# --- container identity ------------------------------------------------------
APP_UID=65532
APP_GID=65532
TZ=UTC

# --- host groups that own the passed-through devices -------------------------
# Raspberry Pi OS defaults shown. docker_host_setup.sh replaces them with the
# values actually present on this host.
DIALOUT_GID=20
GPIO_GID=993
I2C_GID=994
SPI_GID=995

# --- device nodes ------------------------------------------------------------
# Enable the buses first: add dtparam=i2c_arm=on and dtparam=spi=on to
# /boot/firmware/config.txt and reboot, otherwise these nodes are absent and the
# container will not start.
MARLIN_PORT=/dev/ttyUSB0
GPIO_MEM_DEVICE=/dev/gpiomem
GPIO_CHIP_DEVICE=/dev/gpiochip0
I2C_DEVICE=/dev/i2c-1
SPI_DEVICE_0=/dev/spidev0.0
SPI_DEVICE_1=/dev/spidev0.1

# --- published ports ---------------------------------------------------------
# 0.0.0.0 covers loopback and the LAN. Use 127.0.0.1 to keep it host-only.
WEB_BIND=0.0.0.0
WEB_PORT=8000
CONSOLE_BIND=0.0.0.0
CONSOLE_PORT=8300

# --- macvlan (docker compose --profile lan) ----------------------------------
# Gives the container its own address on the intranet. LAN_IP must sit inside
# LAN_SUBNET and outside the router's DHCP pool.
LAN_PARENT=eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
LAN_IP=192.168.1.240

# --- application secrets -----------------------------------------------------
# Leave blank to have the entrypoint generate a token and print it to the log.
# Anyone holding a token can move the gantry.
CHESS_GANTRY_WEB_TOKEN=
CHESS_GANTRY_DEBUG_TOKEN=
CHESS_GANTRY_DEMO=0
LICHESS_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Clerk authentication for the dashboard ----------------------------------
# Set CLERK_PUBLISHABLE_KEY to put a Clerk sign-in in front of the dashboard.
# The entrypoint then stops generating a shared token. The frontend API host,
# the JWT issuer and the JWKS URL are all derived from the publishable key.
# CLERK_ALLOWED_USER_IDS is the real access control: Clerk instances accept new
# sign-ups by default, so leaving it empty lets any Clerk user move the gantry.
# Copy the user IDs (user_...) from the Clerk dashboard, comma separated.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ALLOWED_USER_IDS=
# Optional. CLERK_AUTHORIZED_PARTIES pins the azp claim to known origins, for
# example http://192.168.1.240:8000. The issuer and JWKS overrides are only
# needed for a custom Clerk domain.
CLERK_AUTHORIZED_PARTIES=
CLERK_JWT_ISSUER=
CLERK_JWKS_URL=
