set -e

# Paths are carried NUL-delimited end to end so that filenames containing
# spaces, tabs or newlines survive the round trip to prettier and git add.
staged_list="$(mktemp)"
trap 'rm -f "$staged_list"' EXIT
git diff --cached --name-only --diff-filter=ACMR -z > "$staged_list"

if [ ! -s "$staged_list" ]; then
  exit 0
fi

py_files=$(tr '\0' '\n' < "$staged_list" | grep -Ei '\.py$' || true)
shell_files=$(tr '\0' '\n' < "$staged_list" | grep -Ei '\.(sh|bash)$' || true)

xargs -0 -r node node_modules/prettier/bin/prettier.cjs \
  --write --ignore-unknown --log-level warn < "$staged_list"

if [ -n "$py_files" ]; then
  uv run python scripts/strip_comments.py --write src tests examples scripts
  uv run python -m black . --quiet
fi

xargs -0 -r -I {} sh -c 'if [ -e "$1" ]; then git add -- "$1"; fi' _ {} < "$staged_list"

if [ -n "$py_files" ] || [ -n "$shell_files" ]; then
  uv run python scripts/steering_check.py .
fi
