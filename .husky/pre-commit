set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

py_files=$(printf '%s\n' "$staged" | grep -Ei '\.py$' || true)
shell_files=$(printf '%s\n' "$staged" | grep -Ei '\.(sh|bash)$' || true)

printf '%s\n' "$staged" | xargs -r node node_modules/prettier/bin/prettier.cjs --write --ignore-unknown --log-level warn

if [ -n "$py_files" ]; then
  uv run python scripts/strip_comments.py --write src tests examples scripts
  uv run python -m black . --quiet
fi

printf '%s\n' "$staged" | while IFS= read -r f; do
  if [ -e "$f" ]; then
    git add -- "$f"
  fi
done

if [ -n "$py_files" ] || [ -n "$shell_files" ]; then
  uv run python scripts/steering_check.py .
fi
